{
	"info": {
		"_postman_id": "3f6b2c1e-9a4d-4b8e-8c27-5e1d0a7f4b92",
		"name": "Tahsin Furkan Keles Willow Wealth Technical Assignment",
		"description": "Requests for the user accreditation service.\n\nStart the stack from the project root with `./run.sh`. The API answers on http://localhost:9999 (`baseUrl`), Kafka UI on http://localhost:8080, Redis Insight on http://localhost:5540 and Prometheus on http://localhost:9090. The API itself is documented at http://localhost:9999/q/swagger-ui.\n\nSubmitting and finalizing answer 202: the change goes to Kafka first and the consumer writes it to the database a moment later. The scripts wait a second after each 202, so every folder can also be run top to bottom in the Collection Runner.\n\nEach admin endpoint accepts 10 requests a second and the client endpoint 100; beyond that the answer is 429 with `Retry-After`.\n\n`Submit accreditation` uses a new random `userId` each time and stores the `accreditationId` it gets back. The requests after it reuse both.\n\n`Prometheus metrics` comes last, so the counters it checks have been through the requests before it. Prometheus scrapes the same endpoint every 5 seconds.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Readiness",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Service is ready', () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().status).to.eql('UP');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/q/health/ready",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"q",
								"health",
								"ready"
							]
						},
						"description": "UP once PostgreSQL and Kafka can be reached; Redis is only a cache and is left out. `run.sh` waits on the same endpoint."
					},
					"response": []
				}
			]
		},
		{
			"name": "Submit and review",
			"description": "Submit an accreditation, look it up, confirm it, expire it, then read its history.",
			"item": [
				{
					"name": "Submit accreditation",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// A new user every time, so the request can be sent again without running into the pending one.",
									"pm.collectionVariables.set('userId', pm.variables.replaceIn('{{$guid}}').replace(/-/g, ''));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Accepted', () => {",
									"    pm.response.to.have.status(202);",
									"    pm.collectionVariables.set('accreditationId', pm.response.json().accreditation_id);",
									"});",
									"",
									"// The consumer stores the accreditation a moment after the 202. Wait for it before the next request reads it.",
									"setTimeout(() => {}, 1000);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": \"{{userId}}\",\n    \"accreditation_type\": \"BY_INCOME\",\n    \"document\": {\n        \"name\": \"2018.pdf\",\n        \"mime_type\": \"application/pdf\",\n        \"content\": \"ICAiQC8qIjogWyJzcmMvKiJdCiAgICB9CiAgfQp9Cg==\"\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/user/accreditation",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"user",
								"accreditation"
							]
						},
						"description": "Records a new accreditation request as PENDING and answers with its id. The document is the one from the task's example.\n\nIf Kafka can't take the event, the answer is 503 with a `Retry-After` header. Try it with `docker compose stop kafka`."
					},
					"response": []
				},
